ARG RUNTIME_IMAGE
FROM ${RUNTIME_IMAGE}
USER root
RUN mkdir -p /data /www/static /www/tvbox /opt/alist/data /opt/maintenance && chmod 755 /opt/maintenance && chown -R 65532:65532 /data /www /opt/alist/data
COPY --chmod=644 application.jar /opt/maintenance/application.jar
COPY --chmod=644 service_entry.py /opt/maintenance/service_entry.py
ENV MAINTENANCE_DEPLOYMENT=embedded MAINTENANCE_PYTHON=/usr/bin/python3 INSTALL=alist HOME=/tmp
WORKDIR /data
USER 65532:65532
EXPOSE 4567
HEALTHCHECK NONE
ENTRYPOINT ["/usr/bin/python3", "-I", "/opt/maintenance/service_entry.py"]
CMD []
